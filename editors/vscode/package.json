{
  "name": "tnix",
  "version": "0.5.0",
  "publisher": "ubugeeei",
  "displayName": "tnix",
  "description": "Gradual typing support for Nix via tnix-lsp.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/extension.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei/tnix.git"
  },
  "homepage": "https://github.com/ubugeeei/tnix",
  "bugs": {
    "url": "https://github.com/ubugeeei/tnix/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nix",
    "lsp",
    "types",
    "gradual-typing"
  ],
  "engines": {
    "vscode": "^1.110.0"
  },
  "activationEvents": [
    "onLanguage:tnix",
    "onLanguage:nix"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tnix",
        "aliases": [
          "tnix"
        ],
        "extensions": [
          ".nix",
          ".tnix",
          ".d.tnix"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "tnix",
      "properties": {
        "tnix.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the tnix language server executable. Leave blank to auto-detect common Nix profile locations before falling back to tnix-lsp on PATH."
        },
        "tnix.server.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional command-line arguments passed to the tnix language server."
        },
        "tnix.server.cwd": {
          "type": "string",
          "default": "",
          "description": "Optional working directory used when starting the tnix language server."
        },
        "tnix.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the JSON-RPC communication between VS Code and the tnix language server. Set to 'messages' or 'verbose' to debug the server in the tnix output channel."
        }
      }
    },
    "commands": [
      {
        "command": "tnix.restartServer",
        "title": "tnix: Restart Language Server",
        "category": "tnix"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && ./node_modules/.bin/esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.json && node --test dist/*.spec.js",
    "pretest:integration": "pnpm run build && tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('out/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test:integration": "vscode-test",
    "fmt": "prettier --check src package.json tsconfig.json tsconfig.test.json .vscode-test.mjs language-configuration.json README.md",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.25.3",
    "mocha": "^12.0.0",
    "ovsx": "^1.1.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
